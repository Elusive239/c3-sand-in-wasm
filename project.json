{
  "langrev": "1",
  "warnings":  [ "no-unused" ],
  "authors":  [ "Elusive239 <@elusive-noir.bsky.social>" ],
  "version": "0.1.0",
  "sources":  [ "src/**", "src/common/**", "assets/**" ],
  "test-sources":  [ "test/**" ],
  "output": "build",
  "cc": "gcc",
  "targets": {
    "proj": {
      "dependencies":  [  "raylib6" ],
      "dependency-search-paths":  [ "lib" ],
      "type": "executable",
      "output": "build/main"
    },
    "packer": {
      "dependencies":  [ "stbi" ],
      "dependency-search-paths":  [ "lib" ],
      "type": "executable",
      "name": "packer",
      "opt": "O5",
      "sources-override":  [ "tools/packer/pack.c3", "src/common/logging.c3" ],
      "output": "build/packer"
    },
    "wasm": {
      "name": "out",
      "target": "wasm32",
      "type": "executable",
      "reloc": "none",
      "link-libc": false,
      "no-entry": true,
      "opt": "O5",
      "output": "build/wasm",
      "sources-override":  [ "src/app.c3", "src/simulation.c3", "src/common/**", "assets/**" ]
    }
  },
  "cpu": "generic",
  "opt": "O0",
}